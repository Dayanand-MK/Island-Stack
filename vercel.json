{
  "version": 2,
  "routes": [
    {
      "src": "^/$",
      "dest": "/Stacked.html"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/Stacked.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
